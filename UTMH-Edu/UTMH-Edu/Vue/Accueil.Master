    <style>
        .profile-container {
            position: relative;
            width: 150px;
            height: 150px;
            margin-bottom: 15px;
        }

        .min-height-300 {
            min-height: 180px !important;
        }

        .profile-img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* Pour la barre de navigation */
        /*.navbar {
    position: relative;
    top: 20px; 
    z-index: 10;
}*/

        /* Pour le contenu principal qui suit */
        .container-fluid {
            margin-top: -7px; /* Même valeur négative */
        }

        .camera-icon {
            position: absolute;
            bottom: 5px;
            right: 5px;
            background-color: #0d6efd;
            color: white;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

            .camera-icon:hover {
                background-color: #0b5ed7;
            }

        .header-bold th {
            font-weight: 700 !important; /* Gras */
            font-size: 14px !important; /* Optionnel : un peu plus grand */
        }
    </style>


    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
